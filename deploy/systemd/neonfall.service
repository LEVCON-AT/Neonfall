# ═══════════════════════════════════════════════════════════════
#  NEONFALL — SYSTEMD SERVICE (Next.js)
#  Pfad auf VPS: /etc/systemd/system/neonfall.service
# ═══════════════════════════════════════════════════════════════
#
#  Nach Installation:
#    sudo systemctl daemon-reload
#    sudo systemctl enable neonfall
#    sudo systemctl start neonfall
#    sudo systemctl status neonfall

[Unit]
Description=Neonfall Next.js Application (neonfall.levcon.ai)
Documentation=https://github.com/LEVCON-AT/Neonfall
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/neonfall/.next/standalone
EnvironmentFile=/var/www/neonfall/.env

# Start Next.js (Standalone Build)
# WICHTIG: HOSTNAME=0.0.0.0 damit Next.js auf allen Interfaces lauscht
# PORT=3003 weil 3000=Dev, 3001=levcon.at, 3002=levcon.ai belegt sind
Environment="HOSTNAME=0.0.0.0"
Environment="PORT=3003"
Environment="NODE_ENV=production"
ExecStart=/usr/bin/node /var/www/neonfall/.next/standalone/server.js

# Restart Logic
Restart=always
RestartSec=10

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=neonfall

# Resource Limits
MemoryMax=512M
CPUQuota=80%

# Security Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ReadWritePaths=/var/www/neonfall
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
