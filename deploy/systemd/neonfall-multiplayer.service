# ═══════════════════════════════════════════════════════════════
#  NEONFALL — SYSTEMD SERVICE (Multiplayer socket.io)
#  Pfad auf VPS: /etc/systemd/system/neonfall-multiplayer.service
# ═══════════════════════════════════════════════════════════════
#
#  Startet den socket.io Backend für 1v1 Multiplayer matches.
#  Läuft auf Port 3004, wird von nginx via XTransformPort geroutet.
#
#  WICHTIG: Bun muss system-wide installiert sein (nicht nur in /root/.bun/),
#  damit der www-data User es ausführen kann. Siehe Deploy-Doku.

[Unit]
Description=Neonfall Multiplayer Service (socket.io, port 3004)
Documentation=https://github.com/LEVCON-AT/Neonfall
After=network.target neonfall.service
# S8.21.7: StartLimit muss in [Unit] stehen, nicht in [Service].
#   Give up after 5 rapid restarts in 60s (prevents infinite restart loop).
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/neonfall/mini-services/multiplayer
Environment="NODE_ENV=production"

# S8.21.7: Use a wrapper script that finds bun wherever it's installed.
#   Tries: /usr/local/bin/bun → /opt/bun/bin/bun → $HOME/.bun/bin/bun
#   If none found, falls back to node (requires tsx for .ts execution).
#   The actual script is created by vps-update.sh during deploy.
ExecStart=/var/www/neonfall/mini-services/multiplayer/start.sh

# Restart Logic
Restart=always
RestartSec=10

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=neonfall-mp

# Resource Limits
MemoryMax=256M
CPUQuota=40%

# Security Hardening
NoNewPrivileges=true
PrivateTmp=true
# S8.21.7: Removed ProtectHome=true — bun is often installed in /root/.bun/
#   which would be inaccessible. The start.sh wrapper handles path finding.
ReadWritePaths=/var/www/neonfall/mini-services/multiplayer
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
